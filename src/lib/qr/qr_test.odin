// rows_of renders the matrix the way the fixtures are written.
rows_of :: proc(m: Matrix, allocator := context.allocator) -> string {
	b := strings.builder_make(allocator)
	for row in 0 ..< m.size {
		for col in 0 ..< m.size {
			strings.write_byte(&b, m.dark[row * m.size + col] ? '#' : '.')
		}
		if row < m.size - 1 {
			strings.write_byte(&b, '\n')
		}
	}
	return strings.to_string(b)
}

@(test)
test_matches_reference_symbols :: proc(t: ^testing.T) {
	for fixture in FIXTURES {
		m, err := encode_masked(fixture.text, fixture.mask)
		testing.expectf(t, err == .None, "%q: %v", fixture.text, err)
		if err != .None {
			continue
		}
		defer destroy(&m)

		testing.expectf(t, m.version == fixture.version, "%q: version %d, want %d", fixture.text, m.version, fixture.version)
		testing.expectf(t, m.size == fixture.version * 4 + 17, "%q: size %d", fixture.text, m.size)

		got := rows_of(m)
		defer delete(got)
		testing.expectf(t, got == fixture.want, "%q: symbol differs from the reference\n%s", fixture.text, first_diff(got, fixture.want))
	}
}

// first_diff reports the first row that differs, which is far easier to read
// than two 49-line matrices.
first_diff :: proc(got, want: string) -> string {
	got_rows := strings.split(got, "\n")
	want_rows := strings.split(want, "\n")
	defer delete(got_rows)
	defer delete(want_rows)

	for row, i in want_rows {
		if i >= len(got_rows) {
			return "missing row"
		}
		if got_rows[i] != row {
			return fmt.tprintf("row {}\n got {}\nwant {}", i, got_rows[i], row)
		}
	}
	return "same text, different line count"
}

@(test)
test_version_selection :: proc(t: ^testing.T) {
	// The largest payload each version holds, at level M, counting the 4-bit
	// mode and the 8-bit character count (16 bits from version 10 on). The byte
	// after every boundary must roll over to the next version.
	boundaries := []struct {
		length:  int,
		version: int,
	}{
		{14, 1}, {15, 2},
		{26, 2}, {27, 3},
		{42, 3}, {43, 4},
		{62, 4}, {63, 5},
		{84, 5}, {85, 6},
		{106, 6}, {107, 7},
		{122, 7}, {123, 8},
		{152, 8}, {153, 9},
		{180, 9}, {181, 10},
		{213, 10},
	}
	for c in boundaries {
		text := strings.repeat("a", c.length)
		m, err := encode(text)
		testing.expectf(t, err == .None, "%d bytes: %v", c.length, err)
		if err == .None {
			testing.expectf(t, m.version == c.version, "%d bytes: version %d, want %d", c.length, m.version, c.version)
			destroy(&m)
		}
		delete(text)
	}
}

@(test)
test_rejects_what_it_cannot_hold :: proc(t: ^testing.T) {
	_, empty := encode("")
	testing.expect_value(t, empty, Error.Empty)

	too_long := strings.repeat("a", 214) // version 10-M tops out at 213 bytes
	_, err := encode(too_long)
	testing.expect_value(t, err, Error.Too_Long)
	delete(too_long)
}

be32 :: proc(data: []u8) -> int {
	return int(data[0]) << 24 | int(data[1]) << 16 | int(data[2]) << 8 | int(data[3])
}

@(test)
test_png_is_a_png :: proc(t: ^testing.T) {
	m, err := encode("hello")
	testing.expect_value(t, err, Error.None)
	defer destroy(&m)

	scale := 6
	image := png(m, scale)
	defer delete(image)

	signature := []u8{0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A}
	testing.expect(t, len(image) > 8 && string(image[:8]) == string(signature), "PNG signature")

	// IHDR starts at byte 8 with its length, then the type and the payload.
	width := (m.size + QUIET_ZONE * 2) * scale
	testing.expect(t, string(image[12:16]) == "IHDR", "IHDR first")
	testing.expect_value(t, be32(image[16:20]), width)
	testing.expect_value(t, be32(image[20:24]), width)
	testing.expect_value(t, image[24], 1) // 1 bit per pixel
	testing.expect_value(t, image[25], 0) // greyscale

	// The final chunk is IEND with a zero length: type at len-8..len-4, CRC last.
	testing.expect_value(t, string(image[len(image) - 8:len(image) - 4]), "IEND")
}

@(test)
test_data_uri_prefix :: proc(t: ^testing.T) {
	m, err := encode("hello")
	testing.expect_value(t, err, Error.None)
	defer destroy(&m)

	uri := data_uri(m, 4)
	defer delete(uri)
	testing.expect(t, strings.has_prefix(uri, "data:image/png;base64,"), "prefix")
	testing.expect(t, len(uri) > 64, "the image is embedded")
}
