package main

// embedgen lays web/ out as one blob and writes the table that indexes it.
//
// `make assets` runs this tool and then compresses the blob it produces:
//
//	tmp/assets.blob             every file, back to back, uncompressed
//	src/lib/web/assets_gen.odin the (path, offset, size) table
//	src/lib/web/assets.bin      the gzip stream of the blob, made by make
//
// One stream compresses better than one stream per file - 50 KB against 116 KB
// - and the runtime only has to inflate once, because it serves either way
// from memory and never from the blob in place.

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strings"

// one file in the blob
Entry :: struct {
	path:   string, // request path, e.g. "/js/views/config.js"
	offset: int,
	size:   int,
}

main :: proc() {
	root := "web"
	blob_path := "tmp/assets.blob"
	table_path := "src/lib/web/assets_gen.odin"

	args := os.args
	for i := 1; i < len(args); i += 1 {
		switch args[i] {
		case "-root":
			if i + 1 < len(args) {
				root = args[i+1]
				i += 1
			}
		case "-blob":
			if i + 1 < len(args) {
				blob_path = args[i+1]
				i += 1
			}
		case "-table":
			if i + 1 < len(args) {
				table_path = args[i+1]
				i += 1
			}
		case:
			fmt.eprintfln("embedgen: unknown argument {}", args[i])
			os.exit(2)
		}
	}

	blob := make([dynamic]u8, 0, 256 * 1024)
	defer delete(blob)
	entries := make([dynamic]Entry, 0, 32)
	defer delete(entries)

	collect(root, "", &blob, &entries)

	if err := os.write_entire_file(blob_path, blob[:]); err != nil {
		fmt.eprintfln("embedgen: cannot write {}: {}", blob_path, err)
		os.exit(1)
	}

	table := strings.builder_make()
	defer strings.builder_destroy(&table)
	write_table(&table, entries[:], len(blob))

	if err := os.write_entire_file(
		table_path,
		transmute([]u8)strings.to_string(table),
	); err != nil {
		fmt.eprintfln("embedgen: cannot write {}: {}", table_path, err)
		os.exit(1)
	}

	fmt.printfln("  embedded {} files, {} KB", len(entries), len(blob) / 1024)
}

// collect walks `dir` and appends every regular file it finds. Names are sorted
// so the blob is byte-identical for identical input, which keeps rebuilds and
// diffs boring.
collect :: proc(
	dir, prefix: string,
	blob: ^[dynamic]u8,
	entries: ^[dynamic]Entry,
) {
	infos, err := os.read_all_directory_by_path(dir, context.allocator)
	if err != nil {
		fmt.eprintfln("embedgen: cannot read {}: {}", dir, err)
		os.exit(1)
	}
	defer delete(infos)

	names := make([dynamic]string, 0, len(infos))
	defer delete(names)
	for info in infos {
		if len(info.name) > 0 && info.name[0] == '.' {
			continue // .DS_Store and friends
		}
		append(&names, info.name)
	}
	slice.sort(names[:])

	for name in names {
		full := fmt.tprintf("{}/{}", dir, name)
		if os.is_directory(full) {
			collect(full, fmt.tprintf("{}/{}", prefix, name), blob, entries)
			continue
		}
		data, read_err := os.read_entire_file(full, context.allocator)
		if read_err != nil {
			fmt.eprintfln("embedgen: cannot read {}: {}", full, read_err)
			os.exit(1)
		}
		defer delete(data)

		append(
			entries,
			Entry{path = fmt.tprintf("{}/{}", prefix, name), offset = len(blob), size = len(data)},
		)
		append(blob, ..data)
	}
}

// write_table emits the Odin side of the blob. The paths are plain ASCII, so no
// escaping is needed beyond the quotes.
write_table :: proc(b: ^strings.Builder, entries: []Entry, total: int) {
	fmt.sbprintf(b, "package web\n\n")
	fmt.sbprintf(b, "// Code generated by tools/embedgen; DO NOT EDIT.\n")
	fmt.sbprintf(b, "// Regenerate with `make assets`.\n\n")
	fmt.sbprintf(b, "// ASSET_BLOB is the gzip stream of every file under web/, back to back.\n")
	fmt.sbprintf(b, "@(private)\n")
	fmt.sbprintf(b, "ASSET_BLOB := #load(\"assets.bin\")\n\n")
	fmt.sbprintf(b, "// ASSET_SIZE is the size of ASSET_BLOB once inflated.\n")
	fmt.sbprintf(b, "@(private)\n")
	fmt.sbprintf(b, "ASSET_SIZE :: {}\n\n", total)
	fmt.sbprintf(b, "// Asset is one file inside the inflated blob.\n")
	fmt.sbprintf(b, "@(private)\n")
	fmt.sbprintf(b, "Asset :: struct {{\n")
	fmt.sbprintf(b, "\tpath:   string,\n")
	fmt.sbprintf(b, "\toffset: int,\n")
	fmt.sbprintf(b, "\tsize:   int,\n")
	fmt.sbprintf(b, "}}\n\n")
	fmt.sbprintf(b, "// ASSETS is sorted by path.\n")
	fmt.sbprintf(b, "@(private)\n")
	fmt.sbprintf(b, "ASSETS := []Asset{{\n")
	for entry in entries {
		fmt.sbprintf(b, "\t{{\"{}\", {}, {}}},\n", entry.path, entry.offset, entry.size)
	}
	strings.write_string(b, "}\n")
}
